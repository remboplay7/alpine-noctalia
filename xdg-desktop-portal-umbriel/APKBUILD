pkgname=xdg-desktop-portal-umbriel
_commit="79f087598d596ae8a81dff1036d0ab3b5c446584"
pkgver=0_git20261101
pkgrel=0
pkgdesc="Desktop portal for Umbriel WM"
url="https://github.com/noctalia-dev/xdg-desktop-portal-umbriel"
arch="all"
license="MIT"

makedepends="
	g++
	git
	just
	meson
	ninja
	wayland-dev
	wayland-protocols
	wlroots0.20-dev
	libei-dev
	tomlplusplus-dev
	cairo-dev
	pango-dev
	gtk4.0-dev
	libdrm-dev
	pipewire-dev
	sdbus-cpp-dev
"
source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

pkgver() {
	if [ -d "$builddir/.git" ]; then
		cd "$builddir"
		printf "0_git%s.%s" "$(date -u +%Y%m%m)" "$(git rev-parse --short HEAD)"
	else
		printf "0_git20261101.%s" "${_commit:0:7}"
	fi
}

build() {
	abuild-meson build
	meson compile -C build
}

check() {
	:
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

sha512sums="
