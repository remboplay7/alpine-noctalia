# Contributor: remboplay7 <your@email.com>
# Maintainer: remboplay7 <your@email.com>
pkgname=luciole
_commit="ef46ab50862309367278cf2bf33d78e1ee607a04"
pkgver=0_git20261125
pkgrel=0
pkgdesc="Luciole utility from Noctalia ecosystem"
url="https://github.com/noctalia-dev/luciole"
arch="all"
license="MIT"
makedepends="
	meson
	ninja
	pkgconf
	wayland-dev
	wayland-protocols
	curl-dev
	gdk-pixbuf-dev
	tomlplusplus-dev
	pango-dev
	libarchive-dev
	acl-dev
	librsvg-dev
"

source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	stb-master.tar.gz::https://github.com/nothings/stb/archive/refs/heads/master.tar.gz"
builddir="$srcdir/$pkgname-$_commit"
options="!check"

prepare() {
	default_prepare

	mkdir -p "$builddir"/include/stb
	cp "$srcdir"/stb-master/*.h "$builddir"/include/stb/
	cp "$srcdir"/stb-master/*.h "$builddir"/include/
}

build() {
	abuild-meson \
		-Dc_args="-I$builddir/include -I$builddir/include/stb" \
		-Dcpp_args="-I$builddir/include -I$builddir/include/stb" \
		. build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

